font-family = "Rec Mono Doutone"
font-family-bold = "Rec Mono Doutone Bold"
font-family-italic = "Rec Mono Doutone Italic"
font-size = 15.0
font-thicken = true
font-feature = "calt"
font-feature = "liga"

theme = "green-night"

#background-opacity = 0.2
#background = #1e1e2e
#background-image = "/Users/parv.gupta/.config/ghostty/tropic_island_night.jpg"
#background-image-opacity = 0.9
#background-image-fit = "cover"
#background-blur = true

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

macos-non-native-fullscreen = true
macos-option-as-alt = true

mouse-hide-while-typing = true
copy-on-select = clipboard

cursor-style = bar
cursor-style-blink = false
custom-shader = shaders/cursor_sweep.glsl

shell-integration = fish
